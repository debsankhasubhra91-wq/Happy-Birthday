  <!-- Floating Audio Player Bar -->
  <div class="audio-pill" id="globalAudioPill">
    <div class="music-disc playing" id="globalMusicDisc">🎵</div>
    <span style="font-size:13px; font-weight:600; color:#ba2839;" id="audioPillStatusText">Music: Playing</span>
    <div class="audio-bars">
      <div class="audio-bar animating"></div>
      <div class="audio-bar animating"></div>
      <div class="audio-bar animating"></div>
      <div class="audio-bar animating"></div>
    </div>
  </div>

  <!-- Customization Modal -->
  <div class="modal-overlay" id="customizeModal">
    <div class="modal-box">
      <div class="modal-header">
        <h3 class="modal-title">Personalize This Birthday Web 🎀</h3>
        <button class="close-modal-btn" id="closeCustomizeModalBtn">✕</button>
      </div>

      <div class="form-group">
        <label class="form-label">Recipient's Name / Nickname</label>
        <input type="text" class="form-input" id="cfgRecipientName" placeholder="e.g. Bestie / Nickname">
      </div>

      <div class="form-group">
        <label class="form-label">Secret Passcode (4 digits)</label>
        <input type="text" class="form-input" id="cfgPasscode" maxlength="4" placeholder="1234">
      </div>

      <div class="form-group">
        <label class="form-label">Cutie In Frame Caption</label>
        <input type="text" class="form-input" id="cfgCutieCaption" placeholder="Ready to shine? ✨">
      </div>

      <div class="form-group">
        <label class="form-label">Birthday Letter Message</label>
        <textarea class="form-textarea" id="cfgLetterBody" rows="5"></textarea>
      </div>

      <div class="form-group">
        <label class="form-label">Upload Custom Cutie / Memory Photo</label>
        <input type="file" id="cfgCustomPhotoInput" accept="image/*" class="form-input">
        <div id="cfgPhotoPreviewContainer" style="display:none; margin-top:10px; align-items:center; gap:12px; background:#fff5f5; padding:10px 14px; border-radius:14px; border:1.5px dashed #ea384d;">
          <img id="cfgPhotoPreview" style="width:58px; height:58px; object-fit:cover; border-radius:10px; border:2px solid #ea384d;" alt="Preview">
          <div style="flex:1; text-align:left;">
            <div id="cfgPhotoPreviewStatus" style="font-size:13px; font-weight:bold; color:#ba2839;">Photo selected! ✨</div>
            <div style="font-size:11px; color:#777;">Will be saved on "Save Changes"</div>
          </div>
          <button type="button" id="cfgRemovePhotoBtn" style="background:#ffe0db; border:none; color:#ea384d; font-size:13px; padding:6px 12px; border-radius:8px; cursor:pointer; font-weight:bold;" title="Remove this photo">Remove ✕</button>
        </div>
      </div>

      <div style="display:flex; gap:10px; margin-top:10px;">
        <button class="save-modal-btn" id="saveCustomSettingsBtn" style="flex:2;">Save Changes ✨</button>
        <button type="button" class="pill-btn" id="resetDefaultsBtn" style="flex:1; justify-content:center; padding:12px; border-radius:14px; background:#fff0ed; color:#ba2839; font-weight:bold; font-size:14px;">Reset ↺</button>
      </div>
    </div>
  </div>

  <!-- Image Lightbox Modal -->
  <div class="lightbox-overlay" id="lightboxModal">
    <div class="lightbox-card">
      <img src="" alt="Zoomed Memory" class="lightbox-img" id="lightboxImg">
      <p class="lightbox-caption" id="lightboxCaption"></p>
      <button class="back-btn" id="closeLightboxBtn" style="margin-top:16px;">Close ✕</button>
    </div>
  </div>

  <!-- Hidden File Input for Cutie Photo -->
  <input type="file" id="hiddenCutieUploader" accept="image/*" style="display:none;">

  <!-- Background music element -->
  <audio id="bgMusic" loop preload="none">
    <source src="https://www.bensound.com/bensound-music/bensound-ukulele.mp3" type="audio/mpeg">
  </audio>

  <!-- ==============================================
       JAVASCRIPT: INTERACTIVITY, AUDIO & ANIMATIONS
       ============================================== -->
  <script>
    // Permanent user uploaded memories (embedded for 100% offline reliability)
    window.SECRET_PHOTO = 'data:image/jpeg;base64,';
    window.PERMANENT_MEMORIES = [
      'data:image/jpeg;base64,',
      'data:image/jpeg;base64,',
      'data:image/jpeg;base64,',
      'data:image/jpeg;base64,'
    ];

    // ==========================================
    // AUDIO SYNTHESIZER & MUSIC BOX (WEB AUDIO API)
    // 100% reliable, zero external dependencies!
    // ==========================================
    class SoundEngine {
      constructor() {
        this.ctx = null;
        this.isPlayingBgm = false;
        this.masterGain = null;
        this.melodyTimer = null;
        this.melodyStep = 0;
      }

      init() {
        if (!this.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AudioContext();
          this.masterGain = this.ctx.createGain();
          this.masterGain.gain.setValueAtTime(0.7, this.ctx.currentTime);
          this.masterGain.connect(this.ctx.destination);
        }
        if (this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      // Bell / Music Box harmonic chime
      playMusicBoxNote(freq, startTime, duration = 0.8, vol = 0.18) {
        if (!this.ctx) return;
        const out = this.masterGain;
        const partials = [
          [1, 1.0, 1.0],
          [2, 0.4, 1.5],
          [3, 0.2, 2.0],
          [4.2, 0.1, 2.8]
        ];

        partials.forEach(([mult, amp, decayMult]) => {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq * mult, startTime);

          const peak = vol * amp;
          const decay = duration * decayMult;
          gain.gain.setValueAtTime(0, startTime);
          gain.gain.linearRampToValueAtTime(peak, startTime + 0.008);
          gain.gain.exponentialRampToValueAtTime(0.0001, startTime + decay);

          osc.connect(gain);
          gain.connect(out);
          osc.start(startTime);
          osc.stop(startTime + decay + 0.05);
        });
      }

      playTone(freq, type = 'sine', duration = 0.15, vol = 0.15) {
        try {
          this.init();
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
          gain.gain.setValueAtTime(vol * 0.5, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.0001, this.ctx.currentTime + duration);
          osc.connect(gain);
          gain.connect(this.masterGain || this.ctx.destination);
          osc.start();
          osc.stop(this.ctx.currentTime + duration);
        } catch(e) {}
      }

      playKeyClick() {
        this.playTone(720 + Math.random() * 80, 'sine', 0.06, 0.12);
      }

      playErrorBuzz() {
        this.playTone(130, 'sawtooth', 0.25, 0.2);
      }

      playUnlockSuccess() {
        this.init();
        const t = this.ctx.currentTime;
        [[523.25, 0], [659.25, 0.12], [783.99, 0.24], [1046.5, 0.38]].forEach(([f, d]) => {
          this.playMusicBoxNote(f, t + d, 0.6, 0.18);
        });
      }

      playUnboxPop() {
        this.init();
        const t = this.ctx.currentTime;
        this.playMusicBoxNote(587.33, t, 0.3, 0.16);
        this.playMusicBoxNote(880.00, t + 0.08, 0.4, 0.14);
      }

      playCheerFanfare() {
        this.init();
        const t = this.ctx.currentTime;
        const notes = [523.25, 523.25, 523.25, 659.25, 783.99, 1046.50];
        notes.forEach((f, i) => this.playMusicBoxNote(f, t + i * 0.13, 0.45, 0.18));
      }

      playPopBalloon() {
        this.init();
        const t = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(800, t);
        osc.frequency.exponentialRampToValueAtTime(120, t + 0.09);
        gain.gain.setValueAtTime(0.3, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.09);
        osc.connect(gain);
        gain.connect(this.masterGain);
        osc.start(t);
        osc.stop(t + 0.1);
      }

      playCandleBlow() {
        this.init();
        const t = this.ctx.currentTime;
        const bufferSize = this.ctx.sampleRate * 0.4;
        const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          data[i] = Math.random() * 2 - 1;
        }
        const noise = this.ctx.createBufferSource();
        noise.buffer = buffer;
        const filter = this.ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(400, t);
        const gain = this.ctx.createGain();
        gain.gain.setValueAtTime(0.25, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.4);
        noise.connect(filter);
        filter.connect(gain);
        gain.connect(this.masterGain);
        noise.start(t);
      }

      // "Happy Birthday To You" Music Box Melodic Synthesizer
      startBgm() {
        this.init();
        this.isPlayingBgm = true;
        updateAudioPillUI(true);

        // First try HTML5 audio, if fails or pauses fallback to internal synth
        const bgm = document.getElementById('bgMusic');
        if (bgm) {
          bgm.volume = 0.5;
          const p = bgm.play();
          if (p !== undefined) {
            p.catch(() => {
              this.startMelodyLoop();
            });
          }
        } else {
          this.startMelodyLoop();
        }
      }

      startMelodyLoop() {
        if (this.melodyTimer) clearInterval(this.melodyTimer);
        // Note frequencies for Happy Birthday
        // C4, D4, E4, F4, G4, A4, B4, C5
        const melody = [
          { f: 261.63, d: 350 }, { f: 261.63, d: 250 }, { f: 293.66, d: 500 }, { f: 261.63, d: 500 }, { f: 349.23, d: 500 }, { f: 329.63, d: 900 },
          { f: 261.63, d: 350 }, { f: 261.63, d: 250 }, { f: 293.66, d: 500 }, { f: 261.63, d: 500 }, { f: 392.00, d: 500 }, { f: 349.23, d: 900 },
          { f: 261.63, d: 350 }, { f: 261.63, d: 250 }, { f: 523.25, d: 500 }, { f: 440.00, d: 500 }, { f: 349.23, d: 500 }, { f: 329.63, d: 500 }, { f: 293.66, d: 800 },
          { f: 466.16, d: 350 }, { f: 466.16, d: 250 }, { f: 440.00, d: 500 }, { f: 349.23, d: 500 }, { f: 392.00, d: 500 }, { f: 349.23, d: 1100 }
        ];

        let index = 0;
        const playNext = () => {
          if (!this.isPlayingBgm) return;
          const note = melody[index];
          this.playMusicBoxNote(note.f, this.ctx.currentTime, 0.7, 0.15);
          index = (index + 1) % melody.length;
          this.melodyTimer = setTimeout(playNext, note.d);
        };
        playNext();
      }

      stopBgm() {
        this.isPlayingBgm = false;
        if (this.melodyTimer) clearTimeout(this.melodyTimer);
        const bgm = document.getElementById('bgMusic');
        if (bgm) bgm.pause();
        updateAudioPillUI(false);
      }

      toggleBgm() {
        this.init();
        if (this.isPlayingBgm) {
          this.stopBgm();
        } else {
          this.startBgm();
        }
      }
    }

    const sound = new SoundEngine();

    // ==========================================
    // APP STATE & LOCALSTORAGE CONFIGURATION
    // ==========================================
    const DEFAULT_CONFIG = {
      recipientName: 'Bestie',
      passcode: '1234',
      cutieCaption: 'Ready to celebrate your special day? ✨',
      letterBody: `Happy Birthday, Bestie! ❤️\n\nI honestly don't know how to put into words how grateful I am to have you in my life. Thank you for being my biggest supporter, my partner in crime, and the person I can always count on.\n\nThrough all the laughs, random talks, late night rants, and endless inside jokes, you have made every single day brighter and so much more special.\n\nOn your birthday, I wish you all the happiness, joy, and success in the whole wide world! Keep shining bright like you always do!`,
      customCutieImg: '',
      unwrappedGifts: []
    };

    let config = { ...DEFAULT_CONFIG };
    try {
      const saved = localStorage.getItem('shinchan_bday_config');
      if (saved) {
        config = { ...DEFAULT_CONFIG, ...JSON.parse(saved) };
        if (!config.recipientName || config.recipientName.length < 2) {
          config.recipientName = 'Bestie';
        }
        if (!config.passcode || String(config.passcode).trim() === '') {
          config.passcode = '1234';
        }
      }
    } catch(e) {}

    function saveConfig() {
      try {
        localStorage.setItem('shinchan_bday_config', JSON.stringify(config));
      } catch(e) {}
    }

    // Photo compress helper
    function compressImageFile(file, callback) {
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          const maxDim = 900;
          let width = img.width;
          let height = img.height;
          if (width > maxDim || height > maxDim) {
            if (width > height) {
              height = Math.round((height * maxDim) / width);
              width = maxDim;
            } else {
              width = Math.round((width * maxDim) / height);
              height = maxDim;
            }
          }
          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);
          try {
            const compressed = canvas.toDataURL('image/jpeg', 0.85);
            callback(compressed);
          } catch(err) {
            callback(e.target.result);
          }
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    // Cutie & Memory Photos playlist
    let cutiePhotos = [
      'assets/memory_1.jpg',
      'assets/memory_2.jpg',
      'assets/memory_3.jpg',
      'assets/memory_4.jpg'
    ];
    let cutiePhotoIdx = 0;

    function applyConfigToUI() {
      document.getElementById('hintPasscodeSpan').textContent = config.passcode;
      document.getElementById('cutieCaptionText').textContent = config.cutieCaption;
      document.getElementById('letterSalutationText').textContent = `Dear ${config.recipientName},`;
      document.getElementById('letterBodyText').textContent = config.letterBody;

      const photoSrc = config.customCutieImg || 'assets/cutie_sample.jpg';
      const cutieImg = document.getElementById('cutieDisplayImg');
      if (cutieImg) cutieImg.src = photoSrc;

      // Permanent memories preserved in Box 2

      cutiePhotos[0] = photoSrc;
      updateUnwrappedCounter();
    }

    // ==========================================
    // INTERACTIVE CURSOR SPARKLE TRAIL
    // ==========================================
    const sparkleEmojis = ['✨', '💖', '⭐', '🌸', '🎀'];
    let lastSparkleTime = 0;

    function createSparkle(x, y) {
      const now = Date.now();
      if (now - lastSparkleTime < 35) return; // throttle
      lastSparkleTime = now;

      const p = document.createElement('div');
      p.className = 'sparkle-trail-particle';
      p.textContent = sparkleEmojis[Math.floor(Math.random() * sparkleEmojis.length)];
      p.style.left = `${x}px`;
      p.style.top = `${y}px`;
      p.style.color = ['#ff85a1', '#ffcbf2', '#fde24f', '#ff70a6'][Math.floor(Math.random() * 4)];
      document.body.appendChild(p);
      setTimeout(() => p.remove(), 800);
    }

    window.addEventListener('mousemove', (e) => createSparkle(e.clientX, e.clientY));
    window.addEventListener('touchmove', (e) => {
      if (e.touches && e.touches[0]) {
        createSparkle(e.touches[0].clientX, e.touches[0].clientY);
      }
    });

    // ==========================================
    // FLOATING BALLOONS POPPING GAME
    // ==========================================
    const balloonsContainer = document.getElementById('balloonsContainer');
    const balloonColors = ['#ff4d6d', '#ff758f', '#ffaa00', '#00b4d8', '#70e000', '#9d4edd', '#ff9e00'];

    function spawnBalloon() {
      if (document.querySelectorAll('.floating-balloon').length > 5) return;
      const b = document.createElement('div');
      b.className = 'floating-balloon';
      const color = balloonColors[Math.floor(Math.random() * balloonColors.length)];
      b.style.left = `${10 + Math.random() * 80}%`;
      const dur = 10 + Math.random() * 6;
      b.style.animationDuration = `${dur}s`;

      b.innerHTML = `
        <div class="balloon-body" style="background:${color};"></div>
        <div class="balloon-knot" style="background:${color};"></div>
        <div class="balloon-string"></div>
      `;

      b.addEventListener('click', (e) => {
        e.stopPropagation();
        sound.playPopBalloon();
        triggerConfettiAt(e.clientX, e.clientY);

        // Show floating pop score text
        const txt = document.createElement('div');
        txt.className = 'pop-score-text';
        const cheers = ['Pop! 🎈', '+1 Wish! ✨', 'Yay! 💖', 'Smile! 🌸'];
        txt.textContent = cheers[Math.floor(Math.random() * cheers.length)];
        txt.style.left = `${e.clientX}px`;
        txt.style.top = `${e.clientY}px`;
        document.body.appendChild(txt);
        setTimeout(() => txt.remove(), 900);

        b.remove();
        setTimeout(spawnBalloon, 1200);
      });

      balloonsContainer.appendChild(b);
      setTimeout(() => { if (b.parentNode) b.remove(); }, dur * 1000);
    }

    setInterval(spawnBalloon, 3500);
    spawnBalloon();
    spawnBalloon();

    // ==========================================
    // 3D CARD TILT EFFECT (GIFT BOXES & POLAROIDS)
    // ==========================================
    function setupTiltEffect(elements) {
      elements.forEach(el => {
        el.addEventListener('mousemove', (e) => {
          const rect = el.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          const rotateX = (-y / rect.height) * 14;
          const rotateY = (x / rect.width) * 14;
          el.style.transform = `perspective(600px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.05, 1.05, 1.05)`;
        });
        el.addEventListener('mouseleave', () => {
          el.style.transform = '';
        });
      });
    }

    setupTiltEffect(document.querySelectorAll('.gift-box-card, .secret-polaroid-frame'));

    // ==========================================
    // PAGE NAVIGATION
    // ==========================================
    function showPage(pageId) {
      document.querySelectorAll('.view-page').forEach(page => {
        page.classList.remove('active');
      });
      const target = document.getElementById(pageId);
      if (target) {
        target.classList.add('active');
      }

      const customizeBtn = document.getElementById('customizeTriggerBtn');
      const lockBtn = document.getElementById('lockPageBtn');
      if (pageId === 'pagePasscode') {
        if (customizeBtn) customizeBtn.style.display = 'none';
        if (lockBtn) lockBtn.style.display = 'none';
      } else {
        if (customizeBtn) customizeBtn.style.display = 'inline-flex';
        if (lockBtn) lockBtn.style.display = 'inline-flex';
      }
    }

    // ==========================================
    // PASSCODE LOGIC
    // ==========================================
    let currentPin = '';
    const pinBoxes = [
      document.getElementById('pin0'),
      document.getElementById('pin1'),
      document.getElementById('pin2'),
      document.getElementById('pin3')
    ];

    function updatePinDisplay() {
      for (let i = 0; i < 4; i++) {
        if (i < currentPin.length) {
          pinBoxes[i].textContent = '❤️';
          pinBoxes[i].classList.add('filled');
          pinBoxes[i].style.borderColor = '#ea384d';
          pinBoxes[i].style.background = '#fff5f5';
          pinBoxes[i].style.color = '#bd2838';
        } else {
          pinBoxes[i].textContent = '';
          pinBoxes[i].classList.remove('filled');
          pinBoxes[i].style.borderColor = '';
          pinBoxes[i].style.background = '';
          pinBoxes[i].style.color = '';
        }
      }
    }

    function isPasscodeCorrect(pin) {
      const cleanPin = String(pin || '').trim();
      const targetPin = String(config.passcode || '1234').trim();
      // Accepts saved passcode, universal default 1234, or 0000
      return cleanPin === targetPin || cleanPin === '1234' || cleanPin === '0000';
    }

    function checkPasscode() {
      if (isPasscodeCorrect(currentPin)) {
        // Immediate visual success indicators
        pinBoxes.forEach(box => {
          box.textContent = '✓';
          box.style.borderColor = '#22c55e';
          box.style.background = '#f0fdf4';
          box.style.color = '#15803d';
        });

        try { sound.playUnlockSuccess(); } catch(e) {}
        try { triggerConfettiBlast(); } catch(e) {}
        try { if (!sound.isPlayingBgm) sound.startBgm(); } catch(e) {}

        // Instant and safe unlock transition
        setTimeout(() => {
          showPage('pageGiftsHub');
        }, 220);
      } else {
        try { sound.playErrorBuzz(); } catch(e) {}
        
        const pinContainer = document.getElementById('pinBoxes');
        if (pinContainer) pinContainer.classList.add('shake-anim');

        const shinchanImg = document.getElementById('shinchanLockImg');
        const angryOverlay = document.getElementById('angryOverlay');
        const speechBubble = document.getElementById('angrySpeechBubble');

        if (speechBubble) {
          const angryMessages = [
            'Wrong Password! 😠',
            'Hint: Try 1234! ✨',
            'Action Kamen says NO! 💢',
            'Click 1234 below to unlock! 💡'
          ];
          speechBubble.textContent = angryMessages[Math.floor(Math.random() * angryMessages.length)];
        }

        if (shinchanImg) shinchanImg.classList.add('angry');
        if (angryOverlay) angryOverlay.classList.add('visible');

        // Reset quickly so buttons are not blocked for 2 seconds
        setTimeout(() => {
          if (pinContainer) pinContainer.classList.remove('shake-anim');
          if (shinchanImg) shinchanImg.classList.remove('angry');
          if (angryOverlay) angryOverlay.classList.remove('visible');
          currentPin = '';
          updatePinDisplay();
        }, 900);
      }
    }

    // Keypad number buttons (1-9, 0)
    document.querySelectorAll('.key-btn[data-val]').forEach(btn => {
      btn.addEventListener('click', () => {
        try { sound.init(); sound.playKeyClick(); } catch(e) {}
        if (currentPin.length < 4) {
          currentPin += btn.getAttribute('data-val');
          updatePinDisplay();
          if (currentPin.length === 4) {
            setTimeout(checkPasscode, 150);
          }
        }
      });
    });

    // Delete single digit
    document.getElementById('pinDeleteBtn').addEventListener('click', () => {
      try { sound.playKeyClick(); } catch(e) {}
      currentPin = currentPin.slice(0, -1);
      updatePinDisplay();
    });

    // Unlock / Submit button (unlocks directly or auto-fills if empty)
    document.getElementById('pinClearBtn').addEventListener('click', () => {
      try { sound.playKeyClick(); } catch(e) {}
      if (currentPin.length === 0) {
        currentPin = String(config.passcode || '1234');
        updatePinDisplay();
      }
      setTimeout(checkPasscode, 100);
    });

    // Click hint to auto-fill & immediately unlock
    document.getElementById('hintPasscodeSpan').addEventListener('click', () => {
      try { sound.init(); sound.playKeyClick(); } catch(e) {}
      currentPin = String(config.passcode || '1234');
      updatePinDisplay();
      setTimeout(checkPasscode, 100);
    });

    // Keyboard support (Numbers, Backspace, Enter key)
    window.addEventListener('keydown', (e) => {
      const activePage = document.querySelector('.view-page.active');
      if (activePage && activePage.id === 'pagePasscode') {
        if (e.key >= '0' && e.key <= '9') {
          if (currentPin.length < 4) {
            try { sound.playKeyClick(); } catch(err) {}
            currentPin += e.key;
            updatePinDisplay();
            if (currentPin.length === 4) {
              setTimeout(checkPasscode, 150);
            }
          }
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (currentPin.length === 0) {
            currentPin = String(config.passcode || '1234');
            updatePinDisplay();
          }
          checkPasscode();
        } else if (e.key === 'Backspace') {
          try { sound.playKeyClick(); } catch(err) {}
          currentPin = currentPin.slice(0, -1);
          updatePinDisplay();
        }
      }
    });

    function updateUnwrappedCounter() {
      const count = config.unwrappedGifts.length;
      document.getElementById('unwrappedCountText').textContent = count;
      const pct = (count / 6) * 100;
      const fill = document.getElementById('unwrappedProgressFill');
      if (fill) fill.style.width = `${pct}%`;

      config.unwrappedGifts.forEach(id => {
        const st = document.getElementById(`statusGift${id}`);
        if (st) {
          st.textContent = 'Opened ✨';
          st.style.color = '#ea384d';
          st.style.fontWeight = 'bold';
        }
      });
    }

    // ==========================================
    // GIFTS HUB & NAVIGATION EVENT LISTENERS
    // ==========================================
    // Gift box cards on Gifts Hub (Surprises 1 - 6)
    document.querySelectorAll('.gift-item').forEach(item => {
      item.addEventListener('click', (e) => {
        const targetPage = item.getAttribute('data-target');
        const giftId = parseInt(item.getAttribute('data-id'), 10);

        try { sound.init(); sound.playUnboxPop(); } catch(err) {}
        try { triggerConfettiAt(e.clientX, e.clientY); } catch(err) {}

        if (giftId && !config.unwrappedGifts.includes(giftId)) {
          config.unwrappedGifts.push(giftId);
          saveConfig();
          updateUnwrappedCounter();
        }

        if (targetPage) {
          showPage(targetPage);
        }
      });
    });

    document.getElementById('hubNextArrow')?.addEventListener('click', () => {
      try { sound.init(); sound.playUnboxPop(); } catch(err) {}
      if (!config.unwrappedGifts.includes(1)) {
        config.unwrappedGifts.push(1);
        saveConfig();
        updateUnwrappedCounter();
      }
      showPage('pageCutie');
    });

    document.querySelectorAll('.back-to-hub-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        try { sound.playKeyClick(); } catch(err) {}
        showPage('pageGiftsHub');
      });
    });

    document.getElementById('nextToMemoriesBtn')?.addEventListener('click', () => {
      try { sound.playKeyClick(); } catch(err) {}
      if (!config.unwrappedGifts.includes(2)) {
        config.unwrappedGifts.push(2);
        saveConfig();
        updateUnwrappedCounter();
      }
      showPage('pageMemories');
    });
    document.getElementById('nextToLetterBtn')?.addEventListener('click', () => {
      try { sound.playKeyClick(); } catch(err) {}
      if (!config.unwrappedGifts.includes(3)) {
        config.unwrappedGifts.push(3);
        saveConfig();
        updateUnwrappedCounter();
      }
      showPage('pageLetter');
    });
    document.getElementById('nextToCakeBtn')?.addEventListener('click', () => {
      try { sound.playKeyClick(); } catch(err) {}
      if (!config.unwrappedGifts.includes(4)) {
        config.unwrappedGifts.push(4);
        saveConfig();
        updateUnwrappedCounter();
      }
      showPage('pageCake');
    });
    document.getElementById('nextToMixtapeBtn')?.addEventListener('click', () => {
      try { sound.playKeyClick(); } catch(err) {}
      if (!config.unwrappedGifts.includes(5)) {
        config.unwrappedGifts.push(5);
        saveConfig();
        updateUnwrappedCounter();
      }
      showPage('pageMixtape');
    });
    document.getElementById('nextToSecretBtn')?.addEventListener('click', () => {
      try { sound.playKeyClick(); } catch(err) {}
      if (!config.unwrappedGifts.includes(6)) {
        config.unwrappedGifts.push(6);
        saveConfig();
        updateUnwrappedCounter();
      }
      showPage('pageSecret');
    });
    document.getElementById('finishAllSurprisesBtn')?.addEventListener('click', () => {
      try { sound.playCheerFanfare(); } catch(err) {}
      try {
        triggerConfettiBlast();
        setTimeout(triggerConfettiBlast, 350);
      } catch(err) {}
      showPage('pageGiftsHub');
    });

    // Secret Box Heart Clicker
    let secretHearts = 1000;
    document.getElementById('secretHeartBtn')?.addEventListener('click', (e) => {
      secretHearts += 10;
      try { sound.playMusicBoxNote(783.99, sound.ctx ? sound.ctx.currentTime : 0, 0.4, 0.22); } catch(err) {}
      try { triggerConfettiAt(e.clientX, e.clientY); } catch(err) {}
      const counter = document.getElementById('secretHeartCount');
      if (counter) counter.textContent = secretHearts + '+';
      const btn = document.getElementById('secretHeartBtn');
      if (btn) {
        btn.style.transform = 'scale(1.15)';
        setTimeout(() => btn.style.transform = '', 200);
      }
    });

    // Secret Photo Lightbox zoom
    document.getElementById('secretPhotoCard')?.addEventListener('click', () => {
      try { sound.playKeyClick(); } catch(err) {}
      const img = document.getElementById('secretDisplayImg')?.src;
      if (img && lightboxImg) lightboxImg.src = img;
      if (lightboxCaption) lightboxCaption.textContent = 'Always better together. Happy Birthday Bestie! 🌟❤️';
      if (lightboxModal) lightboxModal.classList.add('open');
    });

    // ==========================================
    // SURPRISE 1: SHINCHAN "CLICK ME" INTERACTIVE
    // ==========================================
    const shinchanHeart = document.getElementById('shinchanHeartClicker');
    const shinchanQuotes = [
      "Ohoooo! Happy Birthday gorgeous! 💖",
      "You're the coolest person ever! ✨",
      "Action Kamen sends you 1000 hugs! 🦸‍♂️",
      "Can we eat all the cake now? 🍰",
      "Bestie level: 999999+! 🎉",
      "Keep smiling bright always! 🌸",
      "Party hard today! 🎈🥳"
    ];
    let quoteIndex = 0;
    shinchanHeart.addEventListener('click', (e) => {
      sound.playMusicBoxNote(659.25, sound.ctx ? sound.ctx.currentTime : 0, 0.4, 0.2);
      triggerConfettiAt(e.clientX, e.clientY);
      const bubble = shinchanHeart.querySelector('.click-me-bubble');
      const img = shinchanHeart.querySelector('.shinchan-side-img');
      
      bubble.textContent = shinchanQuotes[quoteIndex % shinchanQuotes.length];
      quoteIndex++;

      // Bubble pop effect without moving position
      bubble.style.transform = 'scale(1.12)';
      if (img) img.style.transform = 'scale(1.12) rotate(-6deg)';

      setTimeout(() => {
        bubble.style.transform = '';
        if (img) img.style.transform = '';
      }, 300);
    });

    // Photo Stickers Toolbar
    document.querySelectorAll('.sticker-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        sound.playKeyClick();
        const stickerText = btn.getAttribute('data-sticker');
        const mediaBox = document.querySelector('.cutie-media-box');
        const badge = document.createElement('div');
        badge.textContent = stickerText;
        badge.style.position = 'absolute';
        badge.style.fontSize = '36px';
        badge.style.left = `${30 + Math.random() * 40}%`;
        badge.style.top = `${20 + Math.random() * 50}%`;
        badge.style.cursor = 'move';
        badge.style.userSelect = 'none';
        badge.style.filter = 'drop-shadow(0 4px 8px rgba(0,0,0,0.3))';
        badge.style.animation = 'popModal 0.25s ease';
        badge.title = 'Click to remove sticker';
        badge.addEventListener('click', () => badge.remove());
        mediaBox.appendChild(badge);
        triggerConfettiAt(e.clientX, e.clientY);
      });
    });

    // Swap Cutie Photos
    document.getElementById('swapCutiePhotoBtn').addEventListener('click', () => {
      sound.playKeyClick();
      cutiePhotoIdx = (cutiePhotoIdx + 1) % cutiePhotos.length;
      document.getElementById('cutieDisplayImg').src = cutiePhotos[cutiePhotoIdx];
    });

    const hiddenCutieUploader = document.getElementById('hiddenCutieUploader');
    document.getElementById('uploadCutiePhotoBtn').addEventListener('click', () => {
      hiddenCutieUploader.click();
    });
    hiddenCutieUploader.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        compressImageFile(file, (compressedDataUrl) => {
          config.customCutieImg = compressedDataUrl;
          saveConfig();
          applyConfigToUI();
          sound.playCheerFanfare();
          triggerConfettiBlast();
        });
      }
    });

    // ==========================================
    // SURPRISE 2: POLAROIDS LIGHTBOX
    // ==========================================
    const lightboxModal = document.getElementById('lightboxModal');
    const lightboxImg = document.getElementById('lightboxImg');
    const lightboxCaption = document.getElementById('lightboxCaption');

    document.querySelectorAll('.polaroid-card').forEach(card => {
      card.addEventListener('click', () => {
        sound.playKeyClick();
        const img = card.querySelector('.polaroid-img').src;
        const text = card.querySelector('.polaroid-text').textContent;
        lightboxImg.src = img;
        lightboxCaption.textContent = text;
        lightboxModal.classList.add('open');
      });
    });

    document.getElementById('closeLightboxBtn').addEventListener('click', () => {
      lightboxModal.classList.remove('open');
    });
    lightboxModal.addEventListener('click', (e) => {
      if (e.target === lightboxModal) {
        lightboxModal.classList.remove('open');
      }
    });

    // ==========================================
    // SURPRISE 3: WAX SEAL INTERACTION
    // ==========================================
    const waxSeal = document.querySelector('.wax-seal');
    if (waxSeal) {
      waxSeal.addEventListener('click', (e) => {
        sound.playMusicBoxNote(783.99, sound.ctx ? sound.ctx.currentTime : 0, 0.5, 0.22);
        triggerConfettiAt(e.clientX, e.clientY);
        waxSeal.style.transform = 'scale(1.3) rotate(20deg)';
        setTimeout(() => waxSeal.style.transform = 'scale(1)', 300);
      });
    }

    // ==========================================
    // SURPRISE 4: BLOW CANDLES ON CAKE
    // ==========================================
    const blowBtn = document.getElementById('blowCandlesBtn');
    const cakeContainer = document.getElementById('cakeContainer');
    let candlesBlown = false;

    function blowCandlesOut() {
      if (candlesBlown) {
        // Relight candles!
        candlesBlown = false;
        sound.playKeyClick();
        cakeContainer.classList.remove('blown');
        blowBtn.innerHTML = '<span>💨</span> Blow Out the Candles!';
        blowBtn.style.background = 'linear-gradient(135deg, #ea384d, #ff5e7e)';
        document.getElementById('wishCelebrationText').style.display = 'none';
        return;
      }

      // Real candle extinguishing sequence
      candlesBlown = true;
      sound.playCandleBlow();
      cakeContainer.classList.add('blown');

      setTimeout(() => {
        sound.playCheerFanfare();
        triggerConfettiBlast();
        setTimeout(triggerConfettiBlast, 350);
      }, 400);

      blowBtn.innerHTML = '<span>🕯️</span> Relight & Wish Again!';
      blowBtn.style.background = 'linear-gradient(135deg, #43a047, #66bb6a)';
      document.getElementById('wishCelebrationText').style.display = 'block';
    }

    blowBtn.addEventListener('click', blowCandlesOut);
    cakeContainer.addEventListener('click', blowCandlesOut);

    // ==========================================
    // SURPRISE 5 & AUDIO PILL
    // ==========================================
    const audioPill = document.getElementById('globalAudioPill');
    const musicDisc = document.getElementById('globalMusicDisc');
    const audioPillStatus = document.getElementById('audioPillStatusText');
    const audioBars = document.querySelectorAll('.audio-bar');

    function updateAudioPillUI(isPlaying) {
      if (isPlaying) {
        musicDisc.classList.add('playing');
        audioPillStatus.textContent = 'Music: Playing 🎵';
        audioBars.forEach(b => b.classList.add('animating'));
        document.getElementById('spool1')?.classList.add('spinning');
        document.getElementById('spool2')?.classList.add('spinning');
      } else {
        musicDisc.classList.remove('playing');
        audioPillStatus.textContent = 'Music: Paused';
        audioBars.forEach(b => b.classList.remove('animating'));
        document.getElementById('spool1')?.classList.remove('spinning');
        document.getElementById('spool2')?.classList.remove('spinning');
      }
    }

    audioPill.addEventListener('click', () => {
      sound.toggleBgm();
    });

    // ==========================================
    // CUSTOMIZATION MODAL CONTROLS
    // ==========================================
    const customizeModal = document.getElementById('customizeModal');
    const customizeTriggerBtn = document.getElementById('customizeTriggerBtn');
    const closeCustomizeModalBtn = document.getElementById('closeCustomizeModalBtn');
    const saveCustomSettingsBtn = document.getElementById('saveCustomSettingsBtn');

    let stagedCustomPhoto = null;

    customizeTriggerBtn.addEventListener('click', () => {
      sound.playKeyClick();
      document.getElementById('cfgRecipientName').value = config.recipientName;
      document.getElementById('cfgPasscode').value = config.passcode;
      document.getElementById('cfgCutieCaption').value = config.cutieCaption;
      document.getElementById('cfgLetterBody').value = config.letterBody;

      stagedCustomPhoto = config.customCutieImg || null;
      const previewContainer = document.getElementById('cfgPhotoPreviewContainer');
      const previewImg = document.getElementById('cfgPhotoPreview');
      const previewStatus = document.getElementById('cfgPhotoPreviewStatus');
      const photoInput = document.getElementById('cfgCustomPhotoInput');
      photoInput.value = '';

      if (stagedCustomPhoto) {
        previewImg.src = stagedCustomPhoto;
        previewStatus.textContent = 'Custom photo is currently active ✨';
        previewContainer.style.display = 'flex';
      } else {
        previewContainer.style.display = 'none';
      }

      customizeModal.classList.add('open');
    });

    closeCustomizeModalBtn.addEventListener('click', () => {
      customizeModal.classList.remove('open');
    });

    document.getElementById('cfgCustomPhotoInput').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (file) {
        compressImageFile(file, (compressedUrl) => {
          stagedCustomPhoto = compressedUrl;
          const previewContainer = document.getElementById('cfgPhotoPreviewContainer');
          const previewImg = document.getElementById('cfgPhotoPreview');
          const previewStatus = document.getElementById('cfgPhotoPreviewStatus');
          previewImg.src = compressedUrl;
          previewStatus.textContent = '✓ Photo ready! Click "Save Changes" ✨';
          previewContainer.style.display = 'flex';
          sound.playKeyClick();
        });
      }
    });

    document.getElementById('cfgRemovePhotoBtn').addEventListener('click', () => {
      sound.playKeyClick();
      stagedCustomPhoto = '';
      document.getElementById('cfgCustomPhotoInput').value = '';
      document.getElementById('cfgPhotoPreviewContainer').style.display = 'none';
    });

    saveCustomSettingsBtn.addEventListener('click', () => {
      sound.playKeyClick();
      config.recipientName = document.getElementById('cfgRecipientName').value.trim() || 'Bestie';
      config.passcode = document.getElementById('cfgPasscode').value.trim() || '1234';
      config.cutieCaption = document.getElementById('cfgCutieCaption').value.trim() || DEFAULT_CONFIG.cutieCaption;
      config.letterBody = document.getElementById('cfgLetterBody').value.trim() || DEFAULT_CONFIG.letterBody;

      if (stagedCustomPhoto !== null) {
        config.customCutieImg = stagedCustomPhoto;
      }

      saveConfig();
      applyConfigToUI();
      customizeModal.classList.remove('open');
      sound.playCheerFanfare();
      triggerConfettiBlast();
    });

    document.getElementById('resetDefaultsBtn').addEventListener('click', () => {
      sound.playKeyClick();
      config = { ...DEFAULT_CONFIG, unwrappedGifts: [] };
      stagedCustomPhoto = null;
      document.getElementById('cfgCustomPhotoInput').value = '';
      document.getElementById('cfgPhotoPreviewContainer').style.display = 'none';
      saveConfig();
      applyConfigToUI();
      customizeModal.classList.remove('open');
      triggerConfettiBlast();
    });

    document.getElementById('lockPageBtn').addEventListener('click', () => {
      sound.playKeyClick();
      currentPin = '';
      updatePinDisplay();
      showPage('pagePasscode');
    });

    // Confetti Helpers
    function triggerConfettiBlast() {
      if (typeof confetti === 'function') {
        confetti({
          particleCount: 85,
          spread: 75,
          origin: { y: 0.6 },
          colors: ['#ea384d', '#ff9eaa', '#ffc107', '#ff7043', '#ffffff']
        });
      }
    }

    function triggerConfettiAt(x, y) {
      if (typeof confetti === 'function') {
        confetti({
          particleCount: 35,
          spread: 60,
          origin: {
            x: x / window.innerWidth,
            y: y / window.innerHeight
          },
          colors: ['#ff4081', '#ffea00', '#00e5ff', '#ff5722', '#ffffff']
        });
      }
    }

    // Initialize UI on load
    applyConfigToUI();
    updatePinDisplay();
    showPage('pagePasscode');
  </script>
</body>
</html>
