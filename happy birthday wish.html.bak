            <!-- 5 Reasons Why You're Special -->
            <h3 style="font-family:var(--font-doodle); font-size:30px; color:#ba2839; text-shadow:1px 1px 0 #fff;">5 Reasons Why You're So Special 💖</h3>

            <div class="reasons-cards-grid">
              <div class="reason-card">
                <span class="reason-num">1</span>
                <span class="reason-text">Your radiant smile lights up any room instantly! ☀️</span>
