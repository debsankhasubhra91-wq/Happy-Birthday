        <!-- ==============================================
             SURPRISE 4: MAKE A WISH (CAKE & CANDLES)
             ============================================== -->
        <div class="view-page" id="pageCake">
          <div class="cake-layout">
            
            <div class="surprise-nav-header" style="width:100%;">
              <button class="back-btn back-to-hub-btn">
                <span>←</span> Back to Gifts
              </button>
              <button class="back-btn" id="nextToMixtapeBtn">
                Next: Birthday Mixtape 🎵 →
              </button>
            </div>

            <h2 class="gifts-title" style="margin-bottom: 4px;">Make a Birthday Wish!</h2>
            <p class="gifts-subtitle">Click the cake or blow button to extinguish the candles! ✨</p>

            <!-- Realistic Layered Birthday Cake with Real Blowing Flames -->
            <div class="cake-container" id="cakeContainer" title="Click to blow out the candles!">
              <svg viewBox="0 0 340 320" class="birthday-cake-svg" id="birthdayCakeSvg" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <!-- Cake Platter Gradient -->
                  <radialGradient id="plateShine" cx="50%" cy="30%" r="50%">
                    <stop offset="0%" stop-color="#ffffff"/>
                    <stop offset="70%" stop-color="#f5ede8"/>
                    <stop offset="100%" stop-color="#ded0c5"/>
                  </radialGradient>
                  <filter id="cakeShadow" x="-20%" y="-20%" width="140%" height="140%">
                    <feDropShadow dx="0" dy="16" stdDeviation="14" flood-color="rgba(180, 50, 40, 0.22)"/>
                  </filter>
                  
                  <!-- Frosting Gradients -->
                  <linearGradient id="bottomFrosting" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#ff758f"/>
                    <stop offset="50%" stop-color="#ff9ebb"/>
                    <stop offset="100%" stop-color="#e05770"/>
                  </linearGradient>
                  <linearGradient id="topFrosting" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#ff9aa2"/>
                    <stop offset="50%" stop-color="#ffb7b2"/>
                    <stop offset="100%" stop-color="#e27f87"/>
                  </linearGradient>
                  <linearGradient id="glazeDrip" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#ffffff"/>
                    <stop offset="100%" stop-color="#fff0f3"/>
                  </linearGradient>
                  
                  <!-- Candle Gradients -->
                  <linearGradient id="candleGrad1" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#ff4081"/>
                    <stop offset="35%" stop-color="#ffd54f"/>
                    <stop offset="70%" stop-color="#ff4081"/>
                    <stop offset="100%" stop-color="#d81b60"/>
                  </linearGradient>
                  <linearGradient id="candleGrad2" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#00b0ff"/>
                    <stop offset="35%" stop-color="#e040fb"/>
                    <stop offset="70%" stop-color="#00b0ff"/>
                    <stop offset="100%" stop-color="#0091ea"/>
                  </linearGradient>
                  <linearGradient id="candleGrad3" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#ff9100"/>
                    <stop offset="35%" stop-color="#ffea00"/>
                    <stop offset="70%" stop-color="#ff9100"/>
                    <stop offset="100%" stop-color="#f57c00"/>
                  </linearGradient>
                </defs>

                <!-- Cake Stand / Plate -->
                <g id="cakeStand" filter="url(#cakeShadow)">
                  <ellipse cx="170" cy="272" rx="140" ry="24" fill="#cbbbb0"/>
                  <ellipse cx="170" cy="268" rx="136" ry="22" fill="url(#plateShine)"/>
                  <ellipse cx="170" cy="266" rx="124" ry="18" fill="#ffffff" opacity="0.75"/>
                  <path d="M150,270 L140,295 L200,295 L190,270 Z" fill="#d8cbbf"/>
                  <ellipse cx="170" cy="295" rx="36" ry="8" fill="#c0b1a4"/>
                </g>

                <!-- Bottom Tier (Layer 1) -->
                <g id="bottomTier">
                  <path d="M60,195 C60,180 280,180 280,195 L280,240 C280,260 60,260 60,240 Z" fill="url(#bottomFrosting)"/>
                  <ellipse cx="170" cy="245" rx="110" ry="16" fill="#e05770" opacity="0.35"/>
                  <ellipse cx="170" cy="195" rx="110" ry="18" fill="#ffa2b7"/>
                  <!-- White Frosting Drips on Bottom Tier -->
                  <path d="M60,195 Q75,218 90,200 Q105,226 120,202 Q140,232 160,205 Q180,230 200,200 Q220,224 240,202 Q260,222 280,195 L280,190 L60,190 Z" fill="url(#glazeDrip)"/>
                  <!-- Sprinkles on Bottom Tier -->
                  <circle cx="85" cy="225" r="3.5" fill="#ffd166"/>
                  <circle cx="115" cy="235" r="3" fill="#06d6a0"/>
                  <circle cx="145" cy="230" r="3.5" fill="#ffffff"/>
                  <circle cx="190" cy="232" r="3" fill="#ffd166"/>
                  <circle cx="225" cy="228" r="3.5" fill="#118ab2"/>
                  <circle cx="255" cy="225" r="3" fill="#ffffff"/>
                </g>

                <!-- Top Tier (Layer 2) -->
                <g id="topTier">
                  <path d="M95,130 C95,115 245,115 245,130 L245,175 C245,195 95,195 95,175 Z" fill="url(#topFrosting)"/>
                  <ellipse cx="170" cy="130" rx="75" ry="15" fill="#ffc2be"/>
                  <!-- White Drip on Top Tier -->
                  <path d="M95,130 Q110,156 122,138 Q135,166 148,136 Q165,170 178,140 Q195,164 210,135 Q228,160 245,130 L245,126 L95,126 Z" fill="#ffffff" opacity="0.95"/>
                  <!-- Top Sprinkles -->
                  <circle cx="120" cy="160" r="3" fill="#ffd166"/>
                  <circle cx="145" cy="168" r="3.5" fill="#ff4081"/>
                  <circle cx="175" cy="162" r="3" fill="#06d6a0"/>
                  <circle cx="205" cy="165" r="3.5" fill="#ffd166"/>
                  <circle cx="230" cy="158" r="3" fill="#ffffff"/>

                  <!-- Cream Rosettes -->
                  <ellipse cx="110" cy="130" rx="10" ry="7" fill="#ffffff"/>
                  <ellipse cx="138" cy="134" rx="11" ry="8" fill="#ffffff"/>
                  <ellipse cx="170" cy="136" rx="12" ry="8" fill="#ffffff"/>
                  <ellipse cx="202" cy="134" rx="11" ry="8" fill="#ffffff"/>
                  <ellipse cx="230" cy="130" rx="10" ry="7" fill="#ffffff"/>

                  <!-- Ripe Cherries/Strawberries -->
                  <circle cx="124" cy="126" r="7.5" fill="#e63946"/>
                  <circle cx="123" cy="124" r="2.2" fill="#ffffff" opacity="0.75"/>
                  <circle cx="216" cy="126" r="7.5" fill="#e63946"/>
                  <circle cx="215" cy="124" r="2.2" fill="#ffffff" opacity="0.75"/>
                </g>

                <!-- 3 Realistic Candles with Extinguishing Flames & Smoke -->
                <!-- Candle 1 (Left) -->
                <g class="candle-unit" id="candleLeft" transform="translate(130, 68)">
                  <rect x="-6" y="24" width="12" height="42" rx="3" fill="url(#candleGrad1)"/>
                  <path d="M0,24 Q-2,16 0,12" stroke="#222" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                  <circle cx="0" cy="12" r="1.8" class="candle-ember" fill="#ff3300"/>
                  <g class="candle-flame-group">
                    <ellipse cx="0" cy="2" rx="16" ry="24" class="flame-halo" fill="rgba(255, 170, 0, 0.22)"/>
                    <path d="M0,-14 Q-8,0 -6,10 Q0,16 6,10 Q8,0 0,-14 Z" class="flame-outer" fill="#ff7a00"/>
                    <path d="M0,-8 Q-5,2 -4,9 Q0,14 4,9 Q5,2 0,-8 Z" class="flame-core" fill="#ffe066"/>
                    <ellipse cx="0" cy="8" rx="2" ry="4" class="flame-inner" fill="#ffffff"/>
                  </g>
                  <path d="M0,10 Q-6,-8 2,-25 T-4,-50" class="candle-smoke-wisp" fill="none" stroke="rgba(215,215,215,0.85)" stroke-width="3" stroke-linecap="round"/>
                </g>

                <!-- Candle 2 (Center - Tallest) -->
                <g class="candle-unit" id="candleCenter" transform="translate(170, 56)">
                  <rect x="-7" y="24" width="14" height="52" rx="3" fill="url(#candleGrad2)"/>
                  <path d="M0,24 Q2,15 0,11" stroke="#222" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                  <circle cx="0" cy="11" r="1.8" class="candle-ember" fill="#ff3300"/>
                  <g class="candle-flame-group">
                    <ellipse cx="0" cy="0" rx="18" ry="26" class="flame-halo" fill="rgba(255, 170, 0, 0.25)"/>
                    <path d="M0,-17 Q-9,-2 -7,9 Q0,15 7,9 Q9,-2 0,-17 Z" class="flame-outer" fill="#ff7a00"/>
                    <path d="M0,-10 Q-6,0 -5,8 Q0,13 5,8 Q6,0 0,-10 Z" class="flame-core" fill="#ffe066"/>
                    <ellipse cx="0" cy="7" rx="2.5" ry="4.5" class="flame-inner" fill="#ffffff"/>
                  </g>
                  <path d="M0,10 Q8,-10 -2,-30 T5,-60" class="candle-smoke-wisp" fill="none" stroke="rgba(215,215,215,0.85)" stroke-width="3.5" stroke-linecap="round"/>
                </g>

                <!-- Candle 3 (Right) -->
                <g class="candle-unit" id="candleRight" transform="translate(210, 68)">
                  <rect x="-6" y="24" width="12" height="42" rx="3" fill="url(#candleGrad3)"/>
                  <path d="M0,24 Q-2,16 0,12" stroke="#222" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                  <circle cx="0" cy="12" r="1.8" class="candle-ember" fill="#ff3300"/>
                  <g class="candle-flame-group">
                    <ellipse cx="0" cy="2" rx="16" ry="24" class="flame-halo" fill="rgba(255, 170, 0, 0.22)"/>
                    <path d="M0,-14 Q-8,0 -6,10 Q0,16 6,10 Q8,0 0,-14 Z" class="flame-outer" fill="#ff7a00"/>
                    <path d="M0,-8 Q-5,2 -4,9 Q0,14 4,9 Q5,2 0,-8 Z" class="flame-core" fill="#ffe066"/>
                    <ellipse cx="0" cy="8" rx="2" ry="4" class="flame-inner" fill="#ffffff"/>
                  </g>
                  <path d="M0,10 Q-7,-12 3,-28 T-2,-55" class="candle-smoke-wisp" fill="none" stroke="rgba(215,215,215,0.85)" stroke-width="3" stroke-linecap="round"/>
                </g>
              </svg>
            </div>

            <button class="blow-btn" id="blowCandlesBtn">
              <span>💨</span> Blow Out the Candles!
            </button>

            <p id="wishCelebrationText" style="display:none; font-family:var(--font-calligraphy); font-size:28px; color:#ba2839; margin-top:14px; animation:pageFadeIn 0.5s ease;">
              🎉 Yay!! May all your sweetest dreams come true! Happy Birthday! 🎂✨
            </p>

          </div>
        </div>

        <!-- ==============================================
